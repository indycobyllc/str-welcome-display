{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "str-welcome-display",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "STR_SETTINGS",
      "id": "80a82f4371204b189669e7153e2bcbe7"
    }
  ],
  "secrets": {
    "required": [
      "ADMIN_TOKEN"
    ]
  }
}
